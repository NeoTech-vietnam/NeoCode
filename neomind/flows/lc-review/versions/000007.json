      },
      {
        "from": "correctness",
        "to": "join",
        "outcome": "completed"
      },
      {
        "from": "memory",
        "to": "join",
        "outcome": "completed"
      },
      {
        "from": "complexity",
        "to": "join",
        "outcome": "completed"
      },
      {
        "from": "join",
        "to": "plan",
        "outcome": "completed"
      },
      {
        "from": "plan",
        "to": "approval",
        "outcome": "completed"
      },
      {
        "from": "approval",
        "to": "coach",
        "outcome": "pass"
      },
      {
        "from": "coach",
        "to": "repair",
        "outcome": "completed"
      },
      {
        "from": "repair",
        "to": "audit",
        "outcome": "completed"
      },
      {
        "from": "audit",
        "to": "finish",
        "outcome": "pass"
      }
    ],
    "bindings": {

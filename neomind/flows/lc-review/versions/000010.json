      }
    },
    "bindingDefaults": {},
    "sessionGroups": [
      {
        "id": "review-session",
        "bindingId": "verifier"
      },
      {
        "id": "coach-session",
        "bindingId": "implementer"
      },
      {
        "id": "audit-session",
        "bindingId": "auditor"
      }
    ],
    "limits": {
      "maxConcurrency": 2,
      "maxRepairRounds": 2,
      "activeTimeSeconds": 1800
    },
    "workspacePolicy": "isolated",
    "outputContract": "code-changes-for-user-review",
    "memoryDefaults": "role"
  },
